{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(apple-touch-icon.*\\.png|icon-.*\\.png|favicon\\.svg|manifest\\.json|manifest\\.webmanifest|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
